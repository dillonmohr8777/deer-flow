(momobot) {
	encode zstd gzip
	reverse_proxy https://{$MOMOBOT_ORIGIN} {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
		flush_interval -1
		transport http {
			tls_server_name {$MOMOBOT_ORIGIN_SNI}
			dial_timeout 10s
			response_header_timeout 600s
		}
		# The PC answering 502/503/504 itself (nginx up, gateway down) gets the same holding page as a dead PC.
		@upstream_down status 502 503 504
		handle_response @upstream_down {
			error "upstream unavailable" 503
		}
	}
	# Holding page (no external assets, inline styles only so Caddy placeholders never touch it). Reloads itself every 30 s.
	handle_errors 502 503 504 {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		header Retry-After "30"
		respond <<HTML
			<!doctype html>
			<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
			<meta http-equiv="refresh" content="30"><title>MomoBot is taking a quick breather</title></head>
			<body style="margin:0;background:#FBF8F4;color:#14181B;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif">
			<main style="min-height:100vh;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center;padding:6vh 8vw;border-left:12px solid #E27113">
			<p style="margin:0 0 2rem;font-size:.85rem;letter-spacing:.14em;text-transform:uppercase;color:#A35309;font-weight:700">Momentum &middot; MomoBot</p>
			<h1 style="margin:0 0 1.25rem;font-size:clamp(2rem,6vw,3.75rem);line-height:1.08;font-weight:800;max-width:16ch">MomoBot is taking a quick breather.</h1>
			<p style="margin:0 0 2.5rem;font-size:clamp(1.1rem,2.4vw,1.5rem);line-height:1.45;max-width:34ch">We're on it and will be right back.</p>
			<p style="margin:0;font-size:1rem;color:#155E86">Need us now? <a href="mailto:dillon@needmomentum.com" style="color:#155E86;font-weight:700">dillon@needmomentum.com</a></p>
			</main></body></html>
			HTML 503
	}
}
momobot.needmomentum.com {
	import momobot
}
{$MOMOBOT_FRONT_SSLIP} {
	import momobot
}
:80 {
	respond /healthz "front ok" 200
}
