{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadMomobotSecrets",
      "Effect": "Allow",
      "Action": ["ssm:GetParametersByPath", "ssm:GetParameter"],
      "Resource": "arn:aws:ssm:us-east-2:*:parameter/momobot/prod*"
    },
    {
      "Sid": "WriteMomobotBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::BUCKET_NAME", "arn:aws:s3:::BUCKET_NAME/*"]
    }
  ]
}
