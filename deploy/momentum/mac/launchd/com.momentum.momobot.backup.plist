<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly 03:15 encrypted backup of the gateway volume (offsite_backup.py).
     The key lives in __DEPLOY__/secrets (0700), never in the backup folder. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.momentum.momobot.backup</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__REPO__/deploy/momentum/mac/backup.sh</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>MOMOBOT_DEPLOY_DIR</key><string>__DEPLOY__</string></dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__DEPLOY__/logs/backup.log</string>
  <key>StandardErrorPath</key><string>__DEPLOY__/logs/backup.log</string>
</dict>
</plist>
