      "css": ".ds-agent{display:flex;align-items:center;gap:12px;width:100%;padding:14px 12px;border:1px solid #d2e3f2;border-radius:14px;background:rgba(255,255,255,.93);color:#07172f;text-align:left;box-shadow:0 18px 50px rgba(7,91,216,.1);transition:160ms}.ds-agent svg{width:34px;fill:none;stroke:#075bd8}.ds-agent span{display:grid;gap:2px}.ds-agent small{color:#50657b}.ds-agent:hover,.ds-agent[aria-pressed=true]{border-color:#075bd8;background:linear-gradient(135deg,#edf7ff,#f2f0ff)}"
