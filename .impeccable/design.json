  "narrative": {
    "northStar": "Momentum Current",
    "overview": "Momentum is a living blue-white operating surface where language becomes work and work resolves into evidence. White and ice-blue fields carry a controlled current of cobalt, cyan, indigo, and violet. Every agent and conversation receives a deterministic authored vector identity; glow and motion amplify only recorded, selected, focused, or changing state.",
    "keyCharacteristics": [
      "White and ice-blue grounds with Momentum cobalt structure and restrained spectral accents.",
      "A luminous lead-agent source connected to specialist work and execution receipts.",
      "Deterministic Momentum vector glyphs instead of emoji or platform-dependent pictograms.",
      "Semantic generated-copy color and motion that stops under reduced-motion preferences."
    ],
    "rules": [
      {
        "name": "The Truth Before Glow Rule",
        "body": "Color, glow, and motion may amplify recorded state; they never manufacture activity, success, cost, or urgency.",
        "section": "colors"
      },
      {
        "name": "The Spectral Semantics Rule",
        "body": "Blue means structure, bright cyan means graphical motion, readable cyan carries small text, violet means model intelligence, green means verified completion, and red means a real exception.",
        "section": "colors"
      },
      {
        "name": "The Friendly Density Rule",
        "body": "Use weight, spacing, and semantic color to make dense information scan quickly; keep body copy comfortably readable.",
        "section": "typography"
      },
      {
        "name": "The State Earns Light Rule",
        "body": "Resting content stays clear and quiet; stronger glow belongs only to live, selected, focused, or actively changing state.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do drive activity, counts, model names, costs, and status from recorded runtime evidence.",
      "Do pair the authentic Momentum mark and self-hosted type with deterministic vector glyphs.",
      "Do preserve loading, error, empty, disabled, hover, keyboard-focus, and reduced-motion states.",
      "Do keep generated copy colorful by meaning and readable over long sessions.",
      "Do keep mobile controls clear of the composer and other primary actions."
    ],
    "donts": [
      "Do not use emoji, Unicode stand-ins, or platform-dependent pictograms as identity.",
      "Do not add perpetual motion, decorative fake progress, or glow to resting content.",
      "Do not turn unavailable data into zero or configured agents into claims of running workers.",
      "Do not flatten the lead-agent current into a generic same-size card grid.",
      "Do not let spectral styling reduce contrast or become rainbow confetti."
    ]
  }
}
