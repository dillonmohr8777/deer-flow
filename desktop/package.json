{
  "name": "momobot-openai-desktop",
  "productName": "MomoBot",
  "version": "0.2.1",
  "private": true,
  "description": "MomoBot desktop app for the existing private Momentum agency.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "npm run typecheck && npm run lint",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "package:mac": "node scripts/package.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "electron": "44.5.0",
    "eslint": "10.11.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
